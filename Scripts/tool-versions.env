# Single source of truth for the exact build/analysis tool artifacts that the
# CI gates and local preflight run. Read by Scripts/install-tools.sh (the only
# installer) and by CI/preflight version checks; never restate a version
# elsewhere.
#
# Bumping a tool is a deliberate change: re-run the gate it feeds against the
# new version on unchanged source, confirm findings/metrics did not move, then
# edit the version AND the sha256 of the artifact (URLs are derived from the
# version in Scripts/install-tools.sh) (the digest GitHub shows on
# the release asset) in one commit.
#
# Policy per tool:
#   swiftlint, swiftformat, swift-complexity, xcodegen: exact release artifact,
#     sha256-verified, macOS arm64 runners.
#   llvm@18 (fuzz.yml): Homebrew formula major pin only; it supplies the
#     libFuzzer runtime for a scheduled, non-gating fuzz job, so the minor
#     version is allowed to float.

SWIFTLINT_VERSION=0.63.2
SWIFTLINT_SHA256=c59a405c85f95b92ced677a500804e081596a4cae4a6a485af76065557d6ed29

SWIFTFORMAT_VERSION=0.64.7
SWIFTFORMAT_SHA256=e82e224325cbd3403fc7b68caf6c917926dc106de3af875fca4b87e3c4634038

SWIFT_COMPLEXITY_VERSION=1.6.0
SWIFT_COMPLEXITY_SHA256=a54d2731acacbe912bb42f61b81836fe3c18dbbed12469fb812436a0d3f10ffb

XCODEGEN_VERSION=2.46.0
