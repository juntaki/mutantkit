index 28e09bd..ba3cfad 100644
--- a/Sources/IntegerUtilities/GCD.swift
+++ b/Sources/IntegerUtilities/GCD.swift
@@ -38,3 +38,15 @@ public func gcd<T: BinaryInteger>(_ a: T, _ b: T) -> T {
   // If that fails, produce a diagnostic.
   fatalError("GCD (\(x)) is not representable as \(T.self).")
 }
+
+/// The [least common multiple][lcm] of `a` and `b`.
+///
+/// If either input is zero, the result is zero.
+///
+/// [lcm]: https://en.wikipedia.org/wiki/Least_common_multiple
+@inlinable
+public func lcm<T: BinaryInteger>(_ a: T, _ b: T) -> T {
+  if a == 0 || b == 0 { return 0 }
+  return (a / gcd(a, b)) * b
+}
+
